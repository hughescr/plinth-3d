#!/usr/bin/env bash
# pre-commit (design dev-loop.md section 9). So far: checker independence. Step 8 adds the
# format check and the staged-diff greps. Set up by `scripts/setup` (core.hooksPath = .githooks).
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
"$root/scripts/check-independence" || { echo "pre-commit: checker independence failed; commit refused" >&2; exit 1; }
