#!/usr/bin/env bash
# pre-commit (design dev-loop.md section 9), budget 5 s: format check in every Rust workspace,
# checker independence, and the text rules over the staged change. Logic in tools/devloop.
# Set up by `scripts/setup` (core.hooksPath = .githooks).
exec "$(git rev-parse --show-toplevel)/scripts/devloop" pre-commit
