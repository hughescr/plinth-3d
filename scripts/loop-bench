#!/usr/bin/env bash
# Edit-loop benchmark (design dev-loop.md section 3.3). Bench slot only, in an exclusive epoch.
# Run it in the background (it takes minutes): scripts/loop-bench
#
# For each case: one untimed settle run, then 3 repetitions. Before every repetition a fresh
# edit changes the canary value of the edited crate, and the very next command is the timed
# scripts/t. A repetition that rebuilds nothing is invalid. Prints every run and the maximum
# per case; exit 0 only if every maximum is in budget and every repetition is valid.
# Exit: 0 pass; 1 over budget, invalid repetition or a failed command; 4 setup error; 5 stopped.
set -uo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root" || exit 4
die() { echo "LOOP-BENCH SETUP ERROR: $*" >&2; exit 4; }

reps=3
call_limit=120                                # one scripts/t invocation, TERM + KILL bound
# level  crate-to-time  crate-whose-canary-is-edited
cases=(
  "L0 support support"       # clippy after a support edit
  "L1 support support"       # one crate
  "L1 geom geom"             # the root crate
  "L1d support geom"         # geometry-to-dependent
  "L1d cli support"          # support-to-CLI: support, emit and cli rebuild
  "L1 check check"           # checker-only
)
# Aggregate deadline, derived from the case list: every case runs reps + 1 timed-bound
# commands, plus two Lnoop runs, plus 60 s of cleanup.
want=$(((${#cases[@]} * (reps + 1) + 2) * call_limit + 60))
deadline="$(awk -F'\t' '$1 == "Bench" { print $3 }' loop-budgets.tsv)"
[ "$deadline" = "$want" ] || die "loop-budgets.tsv Bench row must have budget_s $want (has '${deadline:-none}')"
if [ -z "${PLINTH_BENCH_INNER:-}" ]; then
  exec env PLINTH_BENCH_INNER=1 timeout --kill-after=5 "$deadline" "$0" "$@"
fi

[ "$(basename "$root")" = bench ] || die "run it in the bench slot (plinth-slots/bench)"
[ -z "$(git status --porcelain)" ] || die "the bench worktree is not clean"

bak="$(mktemp)"
cur="" tp=""
cleanup() { # put back the bench's own edit; confirm the tree is as it was
  [ -z "$tp" ] || { kill -TERM "$tp" 2>/dev/null; wait "$tp" 2>/dev/null; tp=""; }
  [ -z "$cur" ] || { cp "$bak" "$cur"; cur=""; }
  rm -f "$bak"
  [ -z "$(git status --porcelain)" ] || echo "LOOP-BENCH: RESTORE FAILED; tree is dirty" >&2
}
trap cleanup EXIT
trap 'echo "LOOP-BENCH: stopped"; exit 5' INT TERM HUP

run_t() { # args for scripts/t; output in $out, status in $rc; stoppable
  scripts/t "$@" >"$out" 2>&1 &
  tp=$!
  wait "$tp"
  rc=$?
  tp=""
}
out="$(mktemp)"
canary() { if [ "$1" = check ]; then echo checker/src/loop_canary.rs; else echo "crates/$1/src/loop_canary.rs"; fi; }
budget_of() { awk -F'\t' -v l="$1" '$1 == l { print $3 }' loop-budgets.tsv; }

begin="$(date +%s)"
fail=0
run_t Lnoop
run_t Lnoop
verdict="$(tail -n 1 "$out")"
if [ "$rc" -eq 0 ]; then echo "Lnoop (settled, no edit): $verdict"; else echo "Lnoop FAILED: $verdict"; fail=1; fi

seq_n=0
for c in "${cases[@]}"; do
  set -- $c
  level=$1 crate=$2 edited=$3
  file="$(canary "$edited")"
  b="$(budget_of "$level")"
  run_t "$level" "$crate"                      # settle: untimed, result not reported
  case "$rc" in 0 | 3) ;; *) echo "$level $crate settle run failed (exit $rc): $(tail -n 1 "$out")"; fail=1; continue ;; esac
  cp "$file" "$bak"
  cur="$file"
  times="" max=0 invalid=0
  for rep in $(seq "$reps"); do
    old="$(sed -n 's/^    \([0-9][0-9]*\)$/\1/p' "$file")"
    new=$(($(date +%s) + seq_n))               # never repeats an earlier run's value
    seq_n=$((seq_n + 1))
    perl -pi -e 'BEGIN { $v = shift } s/^    \d+$/    $v/' "$new" "$file"
    run_t "$level" "$crate"                    # the next command after the edit
    sec="$(tail -n 1 target/loop-log.tsv | cut -f8)"
    built="$(grep -o '^ *\(Compiling\|Checking\) [^ ]*' target/loop-last.log | awk '{ print $2 }' | tr '\n' ' ')"
    state=ok
    [ -n "$built" ] || { state=INVALID; invalid=1; }
    case "$rc" in 0 | 3) ;; *) state="FAILED(exit $rc)"; invalid=1 ;; esac
    echo "$level $crate rep $rep: $sec s  edit $file $old -> $new  rebuilt: ${built:-nothing}  [$state] $(tail -n 1 "$out" | sed 's/.* \/ //')"
    times="$times $sec"
    max="$(awk -v a="$max" -v b="$sec" 'BEGIN { print (b > a) ? b : a }')"
  done
  cp "$bak" "$file"
  cur=""
  verdict=PASS
  awk -v m="$max" -v b="$b" 'BEGIN { exit !(m > b) }' && verdict="FAIL (maximum over budget)"
  [ "$invalid" = 0 ] || verdict="FAIL (invalid or failed repetition)"
  [ "$verdict" = PASS ] || fail=1
  echo "$level $crate: runs$times / maximum $max s / budget $b s / $verdict"
done
echo "bench duration $(($(date +%s) - begin)) s (not gate time); tree: $([ -z "$(git status --porcelain)" ] && echo restored || echo DIRTY)"
rm -f "$out"
[ "$fail" = 0 ] && echo "LOOP-BENCH PASS" || echo "LOOP-BENCH FAIL"
exit "$fail"
