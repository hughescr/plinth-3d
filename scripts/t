#!/usr/bin/env bash
# The one wrapper for every loop command (design dev-loop.md section 3.2).
#
#   scripts/t Lnoop                       no change -> cargo build, both workspaces
#   scripts/t L0  <crate>                 clippy
#   scripts/t L1  <crate> [nextest args]  build + tests of the crate
#   scripts/t L1d <crate> [nextest args]  tests of a dependent crate after an edit below it
#   L2 to L5 exit with a setup error until their suites exist.
#
# <crate> is a package name, with or without the plinth- prefix; "check" is the checker.
# Exit: 0 pass or NOCHANGE; 1 failure (tests, no tests selected, LOCK WAIT, package-cache
# wait over 2 s, leftover process); 3 LOOP BUDGET EXCEEDED; 4 setup error; 5 timeout.
set -uo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root" || exit 4
pc_limit_ns=2000000000                      # package-cache wait allowed in one command
child_limit=115                             # TERM here, KILL 5 s later: 120 s bound

setup_error() { echo "SETUP ERROR: $*" >&2; exit 4; }
now() { date +%s%N; }
secs() { printf '%d.%02d' $(($1 / 1000000000)) $(($1 % 1000000000 / 10000000)); }

level="${1:-}"
[ -n "$level" ] || setup_error "usage: scripts/t <level> [crate] [nextest args]"
shift
crate="${1:-}"
[ $# -eq 0 ] || shift
extra=("$@")

row="$(awk -F'\t' -v l="$level" '$1 == l { print $3 "\t" $4 }' loop-budgets.tsv)"
[ -n "$row" ] || setup_error "level $level is not in loop-budgets.tsv"
budget="${row%%$'\t'*}"
target="${row##*$'\t'}"

[ -z "${RUSTFLAGS:-}${CARGO_ENCODED_RUSTFLAGS:-}" ] ||
  setup_error "RUSTFLAGS is set; unset it (it would throw away every build artifact)"
for tool in timeout cargo jq; do
  command -v "$tool" >/dev/null || setup_error "$tool is not installed (scripts/setup)"
done

# Thread allocation (section 5.6): fixed per epoch, read from the slot marker, never computed.
gitdir="$(git rev-parse --absolute-git-dir)"
if [ "$gitdir" = "$(git rev-parse --path-format=absolute --git-common-dir)" ]; then
  slot=main
  threads="${PLINTH_MAIN_THREADS:-2}"
else
  slot="$(basename "$root")"
  if [ -e "$gitdir/slot-active" ]; then
    threads="$(sed -n 's/^threads=//p' "$gitdir/slot-active")"
  elif [ "$slot" = bench ]; then
    threads="${PLINTH_BENCH_THREADS:-8}"
  else
    setup_error "slot $slot has no thread allocation (scripts/slot $slot start lane/<name>)"
  fi
fi
if [ "$slot" = bench ] && ls "$(git rev-parse --path-format=absolute --git-common-dir)"/worktrees/*/slot-active >/dev/null 2>&1; then
  setup_error "the bench slot runs only in an exclusive epoch; a writing slot holds an allocation"
fi
case "$threads" in '' | *[!0-9]* | 0) setup_error "bad thread allocation: '$threads'" ;; esac

# What to run.
case "$level" in
  L2 | L3 | L4 | L5) setup_error "level $level is not available yet (its suites arrive in later steps)" ;;
esac
ws="$root"
pa=()
cfg=()
if [ "$level" != Lnoop ]; then
  [ -n "$crate" ] || setup_error "$level needs a crate"
  case "$crate" in
    check | checker | plinth-check) pkg=plinth-check ;;
    plinth-*) pkg="$crate" ;;
    *) pkg="plinth-$crate" ;;
  esac
  if [ "$pkg" = plinth-check ]; then
    ws="$root/checker"
    cfg=(--config-file "$root/.config/nextest.toml")
  else
    pa=(-p "$pkg")
  fi
fi
case "$level" in
  Lnoop)
    crate=-
    cmd=(bash -c 'cargo build --locked && cd checker && cargo build --locked')
    ;;
  L0) cmd=(cargo clippy ${pa[@]+"${pa[@]}"} --all-targets --locked -- -D warnings) ;;
  L1 | L1d)
    cargo nextest --version >/dev/null 2>&1 || setup_error "cargo-nextest is not installed (cargo install cargo-nextest --locked)"
    cmd=(cargo nextest run ${pa[@]+"${pa[@]}"} ${cfg[@]+"${cfg[@]}"} --locked ${extra[@]+"${extra[@]}"})
    ;;
  *) setup_error "unknown level: $level" ;;
esac

mkdir -p "$root/target"
log="$root/target/loop-last.log"
tsv="$root/target/loop-log.tsv"
: >"$log"
tpid=""
stop_group() { # TERM the command's process group, KILL after 5 s, then reap
  [ -n "$tpid" ] || return 0
  kill -TERM -- "-$tpid" 2>/dev/null
  for _ in $(seq 100); do kill -0 "$tpid" 2>/dev/null || break; sleep 0.05; done
  kill -KILL -- "-$tpid" 2>/dev/null
  wait "$tpid" 2>/dev/null
}
trap 'stop_group; echo "INTERRUPTED: command stopped"; exit 5' INT TERM HUP

export CARGO_BUILD_JOBS="$threads" NEXTEST_TEST_THREADS="$threads" CARGO_TERM_COLOR=never
cd "$ws" || exit 4
start="$(now)"
# GNU timeout puts the command in its own process group (pgid = tpid) and signals all of it.
timeout --kill-after=5 "$child_limit" "${cmd[@]}" >"$log" 2>&1 &
tpid=$!

# Watch the streamed log: a wait on the build directory is a hard failure at once; waits on
# the shared package cache are counted and timed (Blocking line to the next line printed).
seen=0 pend="" pcn=0 pcwait=0 lockwait=0
while :; do
  alive=1
  kill -0 "$tpid" 2>/dev/null || alive=0
  n=$(($(wc -l <"$log")))
  if [ "$n" -gt "$seen" ]; then
    t=$(now)
    [ -z "$pend" ] || { pcwait=$((pcwait + t - pend)); pend=""; }
    new="$(sed -n "$((seen + 1)),${n}p" "$log")"
    seen=$n
    blocking="$(grep 'Blocking waiting for file lock' <<<"$new" || true)"
    if [ -n "$blocking" ]; then
      if grep -qv 'package cache' <<<"$blocking"; then lockwait=1; break; fi
      pcn=$((pcn + $(wc -l <<<"$blocking")))
      [[ "$(tail -n 1 <<<"$new")" == *'Blocking waiting for file lock'* ]] && pend=$t
    fi
  fi
  [ "$alive" = 1 ] || break
  sleep 0.05
done
[ "$lockwait" = 0 ] || stop_group
wait "$tpid"
rc=$?
[ -z "$pend" ] || pcwait=$((pcwait + $(now) - pend))
elapsed=$(($(now) - start))
leak=0
# kill -0 on the group answers "does any member exist" without listing processes (pgrep and
# ps are blocked in the agent sandbox, and "cannot list" must not read as "gone").
if kill -0 -- "-$tpid" 2>/dev/null; then
  leak=1
  kill -KILL -- "-$tpid" 2>/dev/null
  sleep 0.2
fi
gone=yes
if kill -0 -- "-$tpid" 2>/dev/null; then gone=NO; echo "WARNING: process group $tpid is not gone" >&2; fi

compiled=$(grep -c '^ *Compiling ' "$log" || true)
touched=$(grep -c '^ *\(Compiling\|Checking\) ' "$log" || true)
tests="$(sed -n 's/.*Summary \[[^]]*\] \([0-9][0-9]*\) tests\{0,1\} run.*/\1/p' "$log" | tail -n 1)"
tests="${tests:-0}"

finish() { # verdict, exit code
  local v="$1" code="$2" load
  load="$(uptime | sed 's/.*load averages*: *//' | tr -d ',' | awk '{ print $1 }')"
  load="${load:-0}"
  case "$v" in "LOOP BUDGET EXCEEDED"*)
    awk -v l="$load" 'BEGIN { exit !(l > 8) }' && v="$v (LOADED: load $load is above 8)" ;;
  esac
  { [ "$code" -eq 0 ] || tail -n 40 "$log"; }
  echo "$level $crate $(secs "$elapsed") s / budget $budget s / target $target s / load $load / tests $tests / pkg-cache waits $pcn ($(secs "$pcwait") s) / threads $threads / $v"
  [ -e "$tsv" ] || printf 'time\tslot\trev\tdiff\tlevel\tcrate\tthreads\tseconds\tbudget_s\tload\ttests\tpkg_waits\tpkg_wait_s\tverdict\trun\trepeat_of\n' >"$tsv"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date +%Y-%m-%dT%H:%M:%S)" "$slot" \
    "$(git -C "$root" rev-parse --short HEAD)" "$(git -C "$root" diff HEAD | shasum -a 256 | cut -c1-12)" "$level" "$crate" \
    "$threads" "$(secs "$elapsed")" "$budget" "$load" "$tests" "$pcn" "$(secs "$pcwait")" "$v" "$(date +%s)-$$" "${PLINTH_REPEAT_OF:-}" >>"$tsv"
  exit "$code"
}

[ "$lockwait" = 0 ] || finish "LOCK WAIT: another cargo process is using this slot's build folder" 1
case "$rc" in 124 | 137) finish "TIMEOUT: stopped at the 120 s bound; process group $tpid gone: $gone" 5 ;; esac
if [ "$rc" -ne 0 ]; then
  if grep -q 'no tests to run' "$log"; then finish "FAIL: NO TESTS SELECTED" 1; fi
  finish "FAIL (exit $rc)" 1
fi
[ "$leak" = 0 ] || finish "FAIL: the command left processes behind (killed; group gone: $gone)" 1
case "$level" in
  Lnoop)
    [ "$compiled" -eq 0 ] || finish "FAIL: $compiled Compiling lines on a no-change build" 1
    [ "$(grep -c '^ *Finished ' "$log")" -ge 2 ] || finish "FAIL: a build did not finish" 1
    ;;
  L0) grep -q '^ *Finished ' "$log" || finish "FAIL: clippy did not finish" 1 ;;
  L1 | L1d) [ "$tests" -gt 0 ] || finish "FAIL: NO TESTS SELECTED" 1 ;;
esac
[ "$pcwait" -le "$pc_limit_ns" ] || finish "FAIL: PACKAGE-CACHE WAIT over 2 s" 1
[ "$elapsed" -le $((budget * 1000000000)) ] || finish "LOOP BUDGET EXCEEDED" 3
if [ "$level" != Lnoop ] && [ "$touched" -eq 0 ]; then finish "NOCHANGE (nothing rebuilt; not an edit-loop result)" 0; fi
finish PASS 0
