#!/usr/bin/env bash
# Fixed worktree slots for parallel agents (design dev-loop.md section 5.5, 5.6).
#
#   scripts/slot init                          make the worktrees s1 s2 s3 bench (safe to repeat)
#   scripts/slot status                        one line per slot
#   scripts/slot <s1|s2|s3> start lane/<name> [--threads N]
#   scripts/slot <s1|s2|s3> end                retire after the orchestrator merged the lane
#
# Slots live in ../plinth-slots/ next to this checkout. Each keeps its own target/ and
# checker/target/ inside it, so a slot's build folders stay warm and are never shared.
# Exit codes: 0 ok; 4 setup error or refusal.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
slots_dir="$(dirname "$root")/plinth-slots"
all_slots="s1 s2 s3 bench"
writing_slots="s1 s2 s3"
total_threads=8                                  # owner cap, all slots plus main together
main_threads="${PLINTH_MAIN_THREADS:-2}"         # share the orchestrator keeps for itself
warn_kb=$((12 * 1024 * 1024))                    # 12 GB per slot

die() { echo "SLOT: $*" >&2; exit 4; }

# "main" in the design is the branch the orchestrator's checkout has. Override: PLINTH_MAIN.
main_branch="${PLINTH_MAIN:-$(git -C "$root" symbolic-ref --short HEAD)}"

is_slot() { case " $all_slots " in *" $1 "*) return 0 ;; esac; return 1; }
is_writing() { case " $writing_slots " in *" $1 "*) return 0 ;; esac; return 1; }

marker() { echo "$(git -C "$slots_dir/$1" rev-parse --absolute-git-dir)/slot-active"; }

threads_of() { sed -n 's/^threads=//p' "$(marker "$1")"; }

kb_of() { { du -sk "$@" 2>/dev/null || true; } | awk '{ s += $1 } END { print s + 0 }'; }

running_in() { # prints pids whose current directory is inside the slot; fails if it cannot tell
  local all
  all="$(lsof -d cwd -Fpn 2>/dev/null)" && [ -n "$all" ] || die "lsof gave no answer; cannot tell whether commands still run in the slot"
  awk -v p="$1/" '/^p/ { pid = substr($0, 2) } /^n/ { if (index(substr($0, 2) "/", p) == 1) print pid }' <<<"$all"
}

disk_check() {
  local dir="$slots_dir/$1" kb
  kb="$(kb_of "$dir/target" "$dir/checker/target")"
  echo "$1 build folders: $((kb / 1024)) MB"
  if [ "$kb" -gt "$warn_kb" ]; then
    echo "SLOT WARNING: $1 build folders are over 12 GB" >&2
    if cargo sweep --version >/dev/null 2>&1; then
      (cd "$dir" && cargo sweep --time 7) && (cd "$dir/checker" && cargo sweep --time 7)
    else
      echo "SLOT WARNING: cargo-sweep is not installed; run: cargo install cargo-sweep" >&2
    fi
  fi
}

cmd_init() {
  mkdir -p "$slots_dir"
  for s in $all_slots; do
    if [ -e "$slots_dir/$s/.git" ]; then echo "$s: exists"; continue; fi
    git -C "$root" worktree add --detach "$slots_dir/$s" "$main_branch" >/dev/null
    echo "$s: created at $(git -C "$slots_dir/$s" rev-parse --short HEAD)"
  done
}

cmd_status() {
  for s in $all_slots; do
    local d="$slots_dir/$s"
    [ -e "$d/.git" ] || { echo "$s: MISSING (run scripts/slot init)"; continue; }
    local br dirty="clean" act="idle"
    br="$(git -C "$d" symbolic-ref --short -q HEAD || echo "detached@$(git -C "$d" rev-parse --short HEAD)")"
    [ -z "$(git -C "$d" status --porcelain)" ] || dirty="DIRTY"
    [ ! -e "$(marker "$s")" ] || act="active threads=$(threads_of "$s")"
    echo "$s: $br $dirty $act"
  done
}

cmd_start() {
  local s="$1" lane="${2:-}" threads=2
  is_writing "$s" || die "$s is not a writing slot (use s1, s2 or s3)"
  [ -n "$lane" ] || die "usage: scripts/slot $s start lane/<name> [--threads N]"
  shift 2
  while [ $# -gt 0 ]; do
    case "$1" in
      --threads) threads="${2:-}"; shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done
  case "$lane" in lane/?*) ;; *) die "branch must be named lane/<name>" ;; esac
  case "$threads" in ''|*[!0-9]*|0) die "--threads must be a positive integer" ;; esac
  local d="$slots_dir/$s"
  [ -e "$d/.git" ] || die "$s is missing; run scripts/slot init"
  [ ! -e "$(marker "$s")" ] || die "$s already has an active lane"
  [ -z "$(git -C "$d" status --porcelain)" ] || die "$s is dirty; commit or clean it first (nothing was changed)"
  local sum="$main_threads" o
  for o in $writing_slots; do
    [ -e "$slots_dir/$o/.git" ] && [ -e "$(marker "$o")" ] && sum=$((sum + $(threads_of "$o")))
  done
  [ $((sum + threads)) -le "$total_threads" ] ||
    die "no thread allocation left: main $main_threads + active slots $((sum - main_threads)) + new $threads > $total_threads"
  git -C "$d" switch -c "$lane" "$main_branch"
  printf 'lane=%s\nthreads=%s\nbase=%s\n' "$lane" "$threads" "$(git -C "$d" rev-parse --short HEAD)" >"$(marker "$s")"
  echo "$s: started $lane with $threads threads"
  disk_check "$s"
}

cmd_end() {
  local s="$1" d="$slots_dir/$1" lane pids
  is_writing "$s" || die "$s is not a writing slot"
  [ -e "$(marker "$s")" ] || die "$s has no active lane"
  lane="$(sed -n 's/^lane=//p' "$(marker "$s")")"
  pids="$(running_in "$d" | sort -u | tr '\n' ' ')"
  [ -z "${pids// /}" ] || die "processes still run in $s (pids: $pids); stop retirement, nothing was changed"
  [ -z "$(git -C "$d" status --porcelain)" ] || die "$s is dirty; nothing was changed"
  git -C "$d" merge-base --is-ancestor "$lane" "$main_branch" || die "$lane is not merged into $main_branch; nothing was changed"
  git -C "$d" switch --detach "$main_branch"
  git -C "$d" branch -d "$lane"
  rm -f "$(marker "$s")"
  echo "$s: retired $lane; now detached at $(git -C "$d" rev-parse --short HEAD)"
}

[ $# -ge 1 ] || die "usage: scripts/slot init | status | <slot> start lane/<name> [--threads N] | <slot> end"
case "$1" in
  init) cmd_init ;;
  status) cmd_status ;;
  *)
    is_slot "$1" || die "unknown command or slot: $1"
    [ $# -ge 2 ] || die "usage: scripts/slot $1 start|end"
    s="$1"; verb="$2"; shift 2
    case "$verb" in
      start) cmd_start "$s" "$@" ;;
      end) cmd_end "$s" ;;
      *) die "unknown verb: $verb" ;;
    esac
    ;;
esac
