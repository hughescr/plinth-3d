#!/usr/bin/env bash
# First command after a clone: points git at the committed hooks and checks the tools.
# Safe to run again. It changes only this clone's git config.
set -euo pipefail

cd "$(dirname "$0")/.."

fail=0
need() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "MISSING: $1 ($2)" >&2
    fail=1
  fi
}

need cargo "install rustup from https://rustup.rs"
need jq "brew install jq"
need hyperfine "brew install hyperfine"
need cargo-nextest "cargo install cargo-nextest --locked"
need timeout "brew install coreutils (GNU timeout; scripts/t needs it)"

if [ -n "${RUSTFLAGS:-}" ]; then
  echo "RUSTFLAGS is set; unset it. It would throw away every build artifact." >&2
  fail=1
fi

# rust-toolchain.toml pins the channel; running cargo here installs it if needed.
cargo --version
cargo fmt --version
cargo clippy --version
(cd checker && cargo --version >/dev/null)

git config core.hooksPath .githooks
echo "core.hooksPath = $(git config core.hooksPath)"

exit "$fail"
