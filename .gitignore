.DS_Store

# Python build products and virtualenvs. Nothing in this repository produces
# them any more -- the last Python was deleted on 2026-08-08 (E8) and a guard
# test now fails the suite if a `.py` file reappears -- but the patterns are
# retained so a stray interpreter run, or a tool that scaffolds a venv, cannot
# quietly leave droppings in a checkout.
__pycache__/
*.pyc
.pytest_cache/
.venv/

# Run outputs never belong in git. They record the result of running one
# particular version of the code -- they are not a revision to the code or
# the docs. Archive them outside the repo instead; see docs/datasheets/README.md
# for the specs / datasheets / artifacts distinction.
docs/artifacts/
/artifacts/
scripts/treant_v2_results.json

# Compiled Typst PDFs (e.g. docs/engineering-journal/reference/*.typ) land here. The .typ/.md
# source stays tracked; the rendered PDF is a build product like any other.
/output/

# Compiled shared objects are build products, never source. This rule was
# written for maturin, which used to drop the PyO3 extension into the crate
# source tree as rust/*/python/*/_native.abi3.so; that binding is gone (E8,
# 2026-08-08) and the rule is kept only as a general build-product guard.
*.so

# Root Cargo.lock is the workspace's sole tracked lockfile. Member-local
# build products, tool caches, and accidental lockfiles are never source.
/target/
/crates/*/target/
/crates/*/.cargo/
/crates/*/.cache/
/crates/*/Cargo.lock
/rust/*/target/
/rust/*/.cargo/
/rust/*/.cache/
/rust/*/Cargo.lock

# Vendored source is exceptional: retain the pinned Manifold snapshot only.
/crates/*/vendor/
!/crates/plinth-solid/
!/crates/plinth-solid/vendor/
/crates/plinth-solid/vendor/*
!/crates/plinth-solid/vendor/manifold/
!/crates/plinth-solid/vendor/manifold/**

# Test-corpus meshes. The migration guide's M0 step creates corpus/models/
# in-repo, but the models themselves are inputs we fetch, not source -- the
# treant alone is 21 MB. Keep the directory and its manifest, never the STLs.
corpus/models/*.stl

# Export-track run outputs (E-phase .chitubox artifacts). Run outputs never
# belong in git; the owner picks artifacts up from here for GUI acceptance.
/exports/
